ml/evaluation/blind_test/private/

# PRIVATE real hub reference frames (third-party footage): never commit, never render/copy their brands
docs/hub/reference_frames/

# Evaluator-only render truth (clock offsets / lens k1 per camera): regenerated by build_hub_plan.py, never committed
assets/hub/render_truth.json
assets/hub/render_truth.yaml
*.blend1

# mocap sources (014_GO): large raw downloads and Rexton own takes (his face / home) never committed
assets/mocap/raw/
