assets/mocap/own/raw/

# M5 test spec variant (generated by assets/hub/mocap/make_lineab_spec.py)
assets/hub/hub_spec_lineAb.json

# QA / video-check outputs (review videos, frames, crops, collision reports): regenerated, never committed
qa/

