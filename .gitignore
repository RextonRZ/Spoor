# Evaluation labels and outputs stay private until rights allow publication
ml/evaluation/datasets/*/ground_truth/
ml/evaluation/datasets/*/media/
backend/data/

# Generated Blender builds (reproducible from assets/hub/build_hub.py)
assets/hub/build/

# QA review material (flags, review videos, manifest): regenerated by qa_checks.py / qa_videos.py
assets/hub/build/qa/

# Mixamo animations (Adobe terms, not CC): used for renders, never committed
assets/hub/build/third_party/mixamo/
# Blind-test stills: unmarked renders + real-CCTV reference stills stay private (reference pack, Blind test)
ml/evaluation/blind_test/private/

# PRIVATE real hub reference frames (third-party footage): never commit, never render/copy their brands
docs/hub/reference_frames/

# Evaluator-only render truth (clock offsets / lens k1 per camera): regenerated by build_hub_plan.py, never committed
assets/hub/render_truth.json
assets/hub/render_truth.yaml
*.blend1

# mocap sources (014_GO): large raw downloads and Rexton own takes (his face / home) never committed
assets/mocap/raw/
assets/mocap/own/raw/

# M5 test spec variant (generated by assets/hub/mocap/make_lineab_spec.py)
assets/hub/hub_spec_lineAb.json

# QA / video-check outputs (review videos, frames, crops, collision reports): regenerated, never committed
qa/

# review-watch hook state (per agent session)
review/.seen_*.json
review/.builder_seen.json

# retired logo concept (an AI-generated image): kept locally as history only, never published
assets/brand/logo_concept_chatgpt.png

# local caches / keys that must never be published
.modal.toml
*.pem
*.key
