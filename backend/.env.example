# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://dev.meta.ai) — server-side only
MODEL_API_KEY=

# Baseten — Muse Spark Open (confirm model ID from the Baseten dashboard / award email)
BASETEN_API_KEY=
BASETEN_MODEL_ID=

# Local storage for originals, derivatives and the evidence DB
DATA_DIR=data

# Optional: postgresql+psycopg://spoor:spoor@db:5432/spoor (default: SQLite file in DATA_DIR)
DATABASE_URL=

# Agent reasoning backend: meta | baseten | none
AGENT_BACKEND=meta

# Access tokens file (copy users.example.json -> users.json; never commit it)
USERS_FILE=users.json
# Secret for signed media links (random per process if empty)
URL_SIGNING_SECRET=
