{
  "$defs": {
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "start_utc": {
          "format": "date-time",
          "title": "Start Utc",
          "type": "string"
        },
        "end_utc": {
          "format": "date-time",
          "title": "End Utc",
          "type": "string"
        }
      },
      "required": [
        "start_utc",
        "end_utc"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "maxLength": 96,
      "pattern": "^case_[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Case Id",
      "type": "string"
    },
    "site_id": {
      "maxLength": 96,
      "pattern": "^site_[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Site Id",
      "type": "string"
    },
    "question": {
      "description": "Investigator's question; data, not instructions to agents",
      "minLength": 3,
      "title": "Question",
      "type": "string"
    },
    "target_description": {
      "description": "Concrete visual noun phrase, e.g. 'blue case'",
      "minLength": 1,
      "title": "Target Description",
      "type": "string"
    },
    "camera_ids": {
      "default": [],
      "items": {
        "maxLength": 96,
        "pattern": "^cam_[A-Za-z0-9][A-Za-z0-9_-]*$",
        "type": "string"
      },
      "title": "Camera Ids",
      "type": "array"
    },
    "window": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeWindow"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "claim_reference": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Courier claim / complaint ref.",
      "title": "Claim Reference"
    },
    "complaint": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The customer's complaint, as reported",
      "title": "Complaint"
    },
    "reported_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the customer reported it",
      "title": "Reported At"
    }
  },
  "required": [
    "case_id",
    "site_id",
    "question",
    "target_description",
    "created_by",
    "created_at"
  ],
  "title": "Case",
  "type": "object"
}
