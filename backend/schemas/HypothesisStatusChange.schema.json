{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "id": {
          "description": "user id, agent role + request id, or service name",
          "title": "Id",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model id when kind == agent",
          "title": "Model"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "verifier_service",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "HypothesisStatus": {
      "enum": [
        "proposed",
        "evaluated",
        "supported",
        "contradicted",
        "insufficient_evidence"
      ],
      "title": "HypothesisStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Append-only status transition with actor and evidence (PRD \u00a711.3).",
  "properties": {
    "change_id": {
      "maxLength": 96,
      "pattern": "^chg_[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Change Id",
      "type": "string"
    },
    "hypothesis_id": {
      "maxLength": 96,
      "pattern": "^hyp_[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Hypothesis Id",
      "type": "string"
    },
    "from_status": {
      "$ref": "#/$defs/HypothesisStatus"
    },
    "to_status": {
      "$ref": "#/$defs/HypothesisStatus"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "maxLength": 96,
        "pattern": "^obs_[A-Za-z0-9][A-Za-z0-9_-]*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "reason": {
      "minLength": 3,
      "title": "Reason",
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    }
  },
  "required": [
    "change_id",
    "hypothesis_id",
    "from_status",
    "to_status",
    "actor",
    "reason",
    "at"
  ],
  "title": "HypothesisStatusChange",
  "type": "object"
}
