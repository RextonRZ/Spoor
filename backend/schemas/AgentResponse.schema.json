{
  "$defs": {
    "AgentCost": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "usd_estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usd Estimate"
        }
      },
      "title": "AgentCost",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "`observation` claims must cite evidence; `hypothesis` claims are explicitly unverified.",
      "properties": {
        "kind": {
          "enum": [
            "observation",
            "hypothesis"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Claim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 96,
      "pattern": "^req_[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "abstained",
        "budget_exhausted",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "unknowns": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "conflicts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "recommended_next_tool": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommended Next Tool"
    },
    "abstain_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstain Reason"
    },
    "cost": {
      "$ref": "#/$defs/AgentCost"
    },
    "model_version": {
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "status",
    "cost",
    "model_version"
  ],
  "title": "AgentResponse",
  "type": "object"
}
