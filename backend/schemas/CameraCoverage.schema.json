{
  "additionalProperties": false,
  "description": "A recorded interval of one camera on the normalized timeline \u2014 what *could* have been seen (PRD \u00a716.1).",
  "properties": {
    "coverage_id": {
      "title": "Coverage Id",
      "type": "string"
    },
    "camera_id": {
      "maxLength": 96,
      "pattern": "^cam_[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Camera Id",
      "type": "string"
    },
    "media_id": {
      "maxLength": 96,
      "pattern": "^media_[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Media Id",
      "type": "string"
    },
    "start_utc": {
      "format": "date-time",
      "title": "Start Utc",
      "type": "string"
    },
    "end_utc": {
      "format": "date-time",
      "title": "End Utc",
      "type": "string"
    },
    "sync_id": {
      "maxLength": 96,
      "pattern": "^sync_[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Sync Id",
      "type": "string"
    },
    "time_uncertainty_ms": {
      "minimum": 0,
      "title": "Time Uncertainty Ms",
      "type": "number"
    }
  },
  "required": [
    "coverage_id",
    "camera_id",
    "media_id",
    "start_utc",
    "end_utc",
    "sync_id",
    "time_uncertainty_ms"
  ],
  "title": "CameraCoverage",
  "type": "object"
}
